# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
PORT=5050
LOG_LEVEL=info
# pretty (readable terminal lines, development default) or json (production default)
# LOG_FORMAT=pretty
# Folder for app.log (all entries) and error.log (errors only), relative to backend/.
# Defaults to "logs" outside production and to no files in production.
# An empty value (LOG_DIR=) disables log files.
# LOG_DIR=logs
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs.
TRUST_PROXY=0

MONGODB_URI=mongodb://127.0.0.1:27017/starter-kit

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=starter-kit-api
JWT_AUDIENCE=starter-kit-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30

# Defaults to true when NODE_ENV=production. Must be true in production.
COOKIE_SECURE=false
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Public frontend URL, used to build password reset links.
APP_URL=http://localhost:5173

RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REFRESH_MAX=100

# smtp | console | memory. "console" prints emails to the log (development only).
EMAIL_TRANSPORT=console
EMAIL_FROM="Starter Kit <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Google sign-in (optional). Leave both empty to hide the "Continue with Google" button.
# Create an OAuth client (type "Web application") in Google Cloud Console and add
# this authorized redirect URI: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to APP_URL + /api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Seed users (pnpm seed). Defaults below are used only outside production;
# production requires explicit values. Existing users are never changed.
# Development defaults: admin@example.com / Admin12345, user@example.com / User12345
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
