# Browser-visible configuration only. Never put secrets in VITE_* variables.

# API base path. Keep "/api" when the frontend and API share a domain
# (Vite proxy in development, reverse proxy in production).
VITE_API_BASE_URL=/api

# Dev server proxy target (read by vite.config.js, not exposed to the browser).
VITE_API_PROXY_TARGET=http://localhost:5050
